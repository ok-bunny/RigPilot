# Required in production. Use at least 16 random characters.
RIGPILOT_ADMIN_USERNAME=admin
RIGPILOT_ADMIN_PASSWORD=

# Optional. When omitted, RigPilot creates data/secret.key on first start.
# RIGPILOT_SECRET_KEY=
RIGPILOT_DATA_DIR=./data
RIGPILOT_SESSION_HOURS=12
RIGPILOT_AGENT_ONLINE_SECONDS=45
# Full per-heartbeat telemetry is kept briefly; compact five-minute hashrate
# history and workload buckets have independent 14-day retention.
RIGPILOT_TELEMETRY_RETENTION_DAYS=2
RIGPILOT_HASHRATE_HISTORY_RETENTION_DAYS=14

# Controller-hosted, signature-verified NVIDIA Ubuntu driver cache.  The
# defaults retain at most three versions while reserving 2 GiB of free disk.
RIGPILOT_NVIDIA_CACHE_MAX_BYTES=2147483648
RIGPILOT_NVIDIA_CACHE_MAX_SET_BYTES=1073741824
RIGPILOT_NVIDIA_CACHE_MIN_FREE_BYTES=2147483648
RIGPILOT_NVIDIA_CACHE_KEEP_VERSIONS=3
RIGPILOT_NVIDIA_CACHE_RETENTION_DAYS=14

# Maximum controller-hosted Agent release package size (default 512 MiB).
RIGPILOT_MAX_AGENT_RELEASE_BYTES=536870912

# Maximum staged Controller code release TAR.GZ size (default 128 MiB).
RIGPILOT_MAX_CONTROLLER_RELEASE_BYTES=134217728

# Set true after placing RigPilot behind an HTTPS reverse proxy.
RIGPILOT_REQUIRE_HTTPS=false
# Trusted reverse-proxy peer IPs as seen by Uvicorn (comma-separated).
# Docker may see the host proxy through a bridge gateway; configure its actual
# address before requiring HTTPS. Do not trust every source with '*'.
FORWARDED_ALLOW_IPS=127.0.0.1
