{
  "server_url": "https://rigpilot.example.com",
  "state_file": "rigpilot-agent-state.json",
  "name": "worker-01",
  "heartbeat_interval": 30,
  "request_timeout": 20,
  "log_level": "INFO",
  "log_file": null,
  "dry_run": false,
  "service_allowlist": [
    "docker",
    "rig-worker"
  ],
  "allow_reboot": false,
  "allow_shutdown": false,
  "allow_agent_updates": false,
  "agent_update_max_mb": 512,
  "agent_update_total_timeout": 900,
  "collect_gpu_metrics": true,
  "nvidia_smi_path": "nvidia-smi",
  "advertise_ssh": false,
  "advertise_sftp": false,
  "ssh_port": 22,
  "ssh_username": null,
  "flight_sheet_file": null,
  "miner_status_file": null,
  "managed_mining_enabled": false,
  "managed_miner_runtime_dir": null,
  "miner_profile_allowlist": [],
  "flight_sheet_extra_key_allowlist": [],
  "miner_service": null,
  "allow_miner_downloads": false,
  "miner_packages_dir": null,
  "miner_download_host_allowlist": [],
  "miner_download_max_mb": 512,
  "miner_download_total_timeout": 300,
  "allow_gpu_oc": false,
  "gpu_oc_allowed_vendors": [
    "nvidia"
  ],
  "gpu_power_limit_min_w": null,
  "gpu_power_limit_max_w": null,
  "gpu_core_clock_offset_min_mhz": -500,
  "gpu_core_clock_offset_max_mhz": 500,
  "gpu_core_clock_lock_min_mhz": 100,
  "gpu_core_clock_lock_max_mhz": 5000,
  "gpu_memory_clock_offset_min_mhz": -1500,
  "gpu_memory_clock_offset_max_mhz": 2000,
  "gpu_memory_clock_lock_min_mhz": 100,
  "gpu_memory_clock_lock_max_mhz": 20000,
  "gpu_fan_min_percent": 30,
  "gpu_fan_max_percent": 100,
  "command_history_limit": 200
}
